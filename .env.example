# DATABASE (Supabase Postgres)
# Prisma connection string — replace with your Supabase project URL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# UPSTASH REDIS (optional — caching / future scalp pub-sub)
UPSTASH_REDIS_REST_URL="https://YOUR_REDIS.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_TOKEN"

# ANGEL ONE SMARTAPI
# Create an app at https://smartapi.angelone.in/
ANGEL_ONE_API_KEY="your_smartapi_api_key"
# Client code / user id from Angel One
ANGEL_ONE_CLIENT_CODE="your_client_code"
# 4-digit PIN used as password for loginByPassword
ANGEL_ONE_PIN="your_4_digit_pin"
# TOTP secret (base32) from the authenticator setup — NOT the 6-digit code
ANGEL_ONE_TOTP_SECRET="your_base32_totp_secret"

# Optional overrides
# ANGEL_ONE_BASE_URL="https://apiconnect.angelone.in"
# When true (default if credentials missing), market data uses deterministic mocks
# MARKETDATA_DEMO_MODE="true"

# Scalp confirmation candle (Stage 7) — optional overrides
# SCALP_CONFIRM_TIMEFRAME="FIVE_MINUTE"
# SCALP_CONFIRM_CLOSE_BEYOND="true"
# SCALP_CONFIRM_RISING_VOLUME="true"
# SCALP_CONFIRM_MIN_BODY_RATIO="0"

# Paper trading defaults
PAPER_STARTING_CASH="100000"
