# DATABASE (Supabase Postgres)
# Pooled URL for the app (Supabase: often port 6543 / PgBouncer)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
# Direct URL for Prisma migrate / db push (Supabase: Session mode or db.*:5432 — not transaction pooler)
# If you are not using a pooler, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# UPSTASH REDIS (optional — caching / future scalp pub-sub)
UPSTASH_REDIS_REST_URL="https://YOUR_REDIS.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_TOKEN"

# ANGEL ONE SMARTAPI
# Create an app at https://smartapi.angelone.in/
ANGEL_ONE_API_KEY="your_smartapi_api_key"
# Client code / user id from Angel One
ANGEL_ONE_CLIENT_CODE="your_client_code"
# 4-digit PIN used as password for loginByPassword
ANGEL_ONE_PIN="your_4_digit_pin"
# TOTP secret (base32) from the authenticator setup — NOT the 6-digit code
ANGEL_ONE_TOTP_SECRET="your_base32_totp_secret"

# Optional overrides
# ANGEL_ONE_BASE_URL="https://apiconnect.angelone.in"
# When true (default if credentials missing), market data uses deterministic mocks
# MARKETDATA_DEMO_MODE="true"

# Scalp confirmation candle (Stage 7) — optional overrides
# SCALP_CONFIRM_TIMEFRAME="FIVE_MINUTE"
# SCALP_CONFIRM_CLOSE_BEYOND="true"
# SCALP_CONFIRM_RISING_VOLUME="true"
# SCALP_CONFIRM_MIN_BODY_RATIO="0"

# Auto paper when scalp rule stack clears (paper only — never broker orders)
# UI toggle defaults OFF; set true to allow cron/auto SELL without UI ack:
# SCALP_AUTO_PAPER_ACK_SELL="true"

# Paper trading defaults
PAPER_STARTING_CASH="100000"
# Optional: log paper open/exit wall-clock traces ([paper-timing] …)
# PAPER_TIMING="true"
# Client traces (browser console): NEXT_PUBLIC_PAPER_TIMING="true"

# Large-order inference from SnapQuote best-5 (paper/analysis toasts). Parsing
# stays on; set false to stop detect/SSE if alerts need retuning.
# LARGE_ORDER_DETECTOR_ENABLED="false"
