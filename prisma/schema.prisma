generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OptionType {
  CE
  PE
}

enum TradeAction {
  BUY
  SELL
}

enum PositionStatus {
  OPEN
  CLOSED
  EXPIRED
}

enum TradingMode {
  SCALP
  SWING
}

enum DirectionalVerdict {
  BULLISH
  BEARISH
  NEUTRAL
}

/// Point-in-time synthesis result + full feature snapshot (additive schema)
model TradeIdea {
  id                 String             @id @default(cuid())
  underlying         String
  mode               TradingMode
  directionalVerdict DirectionalVerdict
  structureAction    String
  structureSide      String
  isSellWrite        Boolean
  reasoning          String
  confidenceLabel    String
  /// Full lane rawIndicators + scores + IV regime at decision time
  featureSnapshot    Json
  /// lanes-v1-2lane-effective | lanes-v2-4lane — additive cohort tag
  synthesisVersion   String?
  createdAt          DateTime           @default(now())

  @@index([underlying, createdAt])
  @@index([structureAction, createdAt])
  @@index([synthesisVersion, createdAt])
}

model PaperOptionsAccount {
  id            String            @id @default(cuid())
  name          String            @default("Default Paper Account")
  cashBalance   Float
  startingCash  Float
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  positions     OptionsPosition[]
}

model OptionsPosition {
  id            String              @id @default(cuid())
  accountId     String
  account       PaperOptionsAccount @relation(fields: [accountId], references: [id])
  underlying    String
  strike        Float
  optionType    OptionType
  expiry        DateTime
  action        TradeAction
  lotSize       Int
  lots          Int
  entryPremium  Float
  /// Premium stop (BUY: below entry; SELL: above entry)
  stopLoss      Float?
  /// Premium take-profit (BUY: above entry; SELL: below entry)
  takeProfit    Float?
  status        PositionStatus      @default(OPEN)
  exitPremium   Float?
  realizedPnl   Float?
  /// MANUAL | TP | SL | EXPIRED
  closeReason   String?
  mode          TradingMode
  symbolToken   String?
  tradingSymbol String?
  openedAt      DateTime            @default(now())
  closedAt      DateTime?
  /// Optional snapshot of chain/liquidity at entry
  entrySnapshot Json?

  @@index([accountId, status])
  @@index([expiry, status])
}

/// Multi-timeframe OHLCV for scalp pipeline (1m/3m/5m/15m).
/// Standard Postgres via Prisma — Timescale hypertables not wired (locked stack).
model MarketCandle {
  id         String   @id @default(cuid())
  underlying String
  /// Angel interval constant: ONE_MINUTE | THREE_MINUTE | FIVE_MINUTE | FIFTEEN_MINUTE | …
  interval   String
  time       DateTime
  open       Float
  high       Float
  low        Float
  close      Float
  volume     Float
  /// angel | demo | yahoo — never silent about stubs
  source     String   @default("angel")
  fetchedAt  DateTime @default(now())

  @@unique([underlying, interval, time])
  @@index([underlying, interval, time])
}

/// Closed-idea outcomes for time-ordered track record
model BacktestOutcome {
  id               String   @id @default(cuid())
  tradeIdeaId      String?
  underlying       String
  mode             TradingMode
  structureBranch  String
  laneScores       Json
  realizedPnl      Float
  won              Boolean
  decidedAt        DateTime
  resolvedAt       DateTime @default(now())
  /// lanes-v1-2lane-effective | lanes-v2-4lane — additive cohort tag
  synthesisVersion String?

  @@index([structureBranch, decidedAt])
  @@index([decidedAt])
  @@index([synthesisVersion, decidedAt])
}
